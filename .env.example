# Local-only settings. Do not put real secrets in this tracked template.
APP_ENV=local
CLOUDVAULT_DATA_DIR=./data/vault
CLOUDVAULT_OIDC_ISSUER=http://localhost:5556/dex
CLOUDVAULT_OIDC_AUDIENCE=cloudvault-api
CLOUDVAULT_OIDC_JWKS_URL=http://localhost:5556/dex/keys
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:1.7b-q4_K_M

# Optional local-only AES key override: base64url-encoded 16, 24, or 32 bytes.
# If omitted, the API generates an ignored key under data/vault/.
# CLOUDVAULT_STORAGE_KEY=

# No AWS credentials, Vercel tokens, or hosted model credentials are used here.
